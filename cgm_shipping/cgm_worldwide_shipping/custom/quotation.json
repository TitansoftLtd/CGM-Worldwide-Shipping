   "label": "Incoterm",
   "module": "CGM Worldwide Shipping",
   "options": "FOB\nEx-works\nDoor-to-door",
   "dt": "Quotation"
  },
  {
   "fieldname": "custom_freight_notes",
   "fieldtype": "Small Text",
   "insert_after": "custom_incoterm",
   "label": "Notes / Clauses",
   "module": "CGM Worldwide Shipping",
   "dt": "Quotation"
  },
  {
   "fieldname": "custom_shipment_dossier",
   "fieldtype": "Link",
