{
 "custom_fields": [
  {
   "fieldname": "custom_freight_type",
   "fieldtype": "Select",
   "insert_after": "transaction_date",
   "label": "Freight Type",
   "module": "CGM Worldwide Shipping",
   "options": "Airfreight\nLCL\nFCL",
   "dt": "Quotation"
  },
  {
   "fieldname": "custom_incoterm",
   "fieldtype": "Select",
